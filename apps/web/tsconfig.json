{
	"extends": "@repo/typescript-config/tsconfig.app",
	"compilerOptions": {
		"allowArbitraryExtensions": true,
		"lib": ["DOM", "ES2023"],
		"target": "es2023",
		"types": ["vite/client"],

		/* Bundling */
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"moduleDetection": "force",
		"moduleResolution": "bundler"
	},
	"include": ["src"]
}
