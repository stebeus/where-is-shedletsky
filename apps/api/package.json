{
	"name": "api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"scripts": {
		"build": "tsc",
		"db:generate": "drizzle-kit migrate",
		"db:migrate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:seed": "node seeds/index.ts",
		"db:studio": "drizzle-kit studio --port=3999 --verbose",
		"dev": "node --watch src/index.ts",
		"start": "node src/index.ts",
		"test": "vitest"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.0",
		"@hono/zod-validator": "^0.9.0",
		"drizzle-orm": "1.0.0-rc.4",
		"hono": "^4.13.0",
		"postgres": "^3.4.9",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@types/node": "^26.1.2",
		"drizzle-kit": "1.0.0-rc.4",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
