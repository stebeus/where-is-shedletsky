{
	"extends": "./tsconfig.base",
	"compilerOptions": {
		// Modules
		"module": "nodenext",
		"rootDir": "${configDir}/src",

		// Emit
		"declarationMap": true,
		"outDir": "${configDir}/dist",
		"sourceMap": true,

		// Projects
		"composite": true
	},
	"include": ["${configDir}/src"],
	"exclude": ["${configDir}/dist", "${configDir}/node_modules"]
}
