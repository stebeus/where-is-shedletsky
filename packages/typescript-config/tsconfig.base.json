{
	"compilerOptions": {
		// Type checking
		"noUncheckedIndexedAccess": true,

		// Interop constraints
		"erasableSyntaxOnly": true,
		"esModuleInterop": true,
		"verbatimModuleSyntax": true,

		// Language and environment
		"target": "esnext",

		// Projects
		"tsBuildInfoFile": "${configDir}/node_modules/.cache/tsconfig.tsbuildinfo",

		// Completeness
		"skipLibCheck": true
	}
}
